# Скопіюйте цей файл у .env.local і заповніть значеннями з вашого проєкту Supabase
# (Supabase Dashboard → Project Settings → API)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings → API → "service_role" secret. Обходить RLS повністю —
# лише для серверних API-роутів (app/api/**), ніколи не в браузер.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID) — згенерувати один раз: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@demark.ua
